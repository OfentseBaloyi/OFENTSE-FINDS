# Supabase (publishable key only — never put a secret/service-role key in NEXT_PUBLIC_ variables)
NEXT_PUBLIC_SUPABASE_URL=https://yeaqbbjxgyptzdxehcit.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Public site URL (used for metadata and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Map tiles (optional). Defaults to the standard OpenStreetMap tiles, which are fine for
# development and light use. For production traffic, use a commercial tile provider.
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Places data (optional). Comma-separated Overpass API endpoints, tried in order.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# Contact sent to OpenStreetMap services in the User-Agent, as their usage policies require.
OSM_CONTACT=hello@example.com

# Town featured on the homepage sections (must be a known town slug)
FEATURED_TOWN=pretoria
